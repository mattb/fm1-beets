 void plat_sysex_send(const uint8_t *frame, uint32_t n) { (void)frame, (void)n; }
+int plat_usb_connected(void) { return 1; }
+int plat_sysex_try_send(const uint8_t *frame, uint32_t n)
+{
+    if (!frame || n < 2u || frame[0] != 0xf0 || frame[n - 1u] != 0xf7) return -1;
+#ifndef PLAT_WEB
+    /* Optional raw SysEx capture, separate from the screen-reader and MIDI log. */
+    static FILE *log;
+    static int opened;
+    if (!opened) {
+        const char *path = getenv("FM1B_SYSEX_LOG");
+        opened = 1;
+        if (path && *path) log = fopen(path, "wb");
+    }
+    if (log) { fwrite(frame, 1, n, log); fflush(log); }
+#endif
+    return 0;
+}
