 void plat_sysex_send(const uint8_t *frame, uint32_t n) { ota_wire_send(frame, n); }
+int plat_usb_connected(void) { return usb.config && !usb.suspended; }
+int plat_sysex_try_send(const uint8_t *frame, uint32_t n)
+{
+    if (!frame || n < 2u || n > SXQ * 3u || frame[0] != 0xf0 || frame[n - 1u] != 0xf7)
+        return -1;
+    /* Prevent a USB reset from clearing the ring midway through publication.
+     * ann_wire_send checks capacity before writing, so this never waits for IRQ. */
+    uint32_t flags = plat_lock();
+    int result = ann_wire_send(frame, n);
+    plat_unlock(flags);
+    return result;
+}
 
